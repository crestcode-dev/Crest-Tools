#!/bin/sh
# chsh - Change login shell for CrestEditor / Alpine Linux environment
set -e

VERSION="1.0.0"
CONFIG_DIR="${HOME:-/public}/.config/crest"
CONFIG_FILE="${CONFIG_DIR}/shell"

usage() {
    cat <<EOF
Usage: chsh [options] [username]

Change your login shell for CrestEditor environment.

Options:
  -s, --shell <shell>    Specify login shell (name or full path)
  -l, --list-shells      List available shells on system
  -u, -h, --help         Display this help message and exit
  -v, --version          Display version information and exit

Examples:
  chsh -s zsh
  chsh -s /bin/bash
  chsh -s fish
  chsh -l

EOF
    exit 0
}

version() {
    echo "chsh (CrestEditor Tools) version $VERSION"
    exit 0
}

list_shells() {
    found=""
    if [ -f /etc/shells ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                \#*|"") continue ;;
                *)
                    if [ -x "$line" ]; then
                        echo "$line"
                        found="1"
                    fi
                    ;;
            esac
        done < /etc/shells
    fi

    # Scan standard shell paths if not already in /etc/shells
    for s in /bin/bash /usr/bin/bash /bin/zsh /usr/bin/zsh /bin/fish /usr/bin/fish /bin/ash /bin/sh; do
        if [ -x "$s" ]; then
            if [ -z "$found" ] || ! grep -Fxq "$s" /etc/shells 2>/dev/null; then
                echo "$s"
            fi
        fi
    done | sort -u
    exit 0
}

resolve_shell() {
    input="$1"
    [ -z "$input" ] && return 1

    case "$input" in
        /*|./*|../*)
            if [ -x "$input" ]; then
                echo "$input"
                return 0
            fi
            ;;
        *)
            target="$(command -v "$input" 2>/dev/null || true)"
            if [ -n "$target" ] && [ -x "$target" ]; then
                echo "$target"
                return 0
            fi
            ;;
    esac

    return 1
}

NEW_SHELL=""

while [ $# -gt 0 ]; do
    case "$1" in
        -s|--shell)
            if [ -z "$2" ]; then
                echo "chsh: option '$1' requires an argument" >&2
                exit 1
            fi
            NEW_SHELL="$2"
            shift 2
            ;;
        -s=*)
            NEW_SHELL="${1#*=}"
            shift
            ;;
        --shell=*)
            NEW_SHELL="${1#*=}"
            shift
            ;;
        -l|--list-shells)
            list_shells
            ;;
        -h|-u|--help)
            usage
            ;;
        -v|--version)
            version
            ;;
        -*)
            echo "chsh: unrecognized option '$1'" >&2
            echo "Try 'chsh --help' for more information." >&2
            exit 1
            ;;
        *)
            # Optional username argument
            shift
            ;;
    esac
done

# Interactive mode if no shell argument provided
if [ -z "$NEW_SHELL" ]; then
    CURRENT=""
    if [ -f "$CONFIG_FILE" ]; then
        CURRENT="$(head -n 1 "$CONFIG_FILE" 2>/dev/null | tr -d '[:space:]')"
    fi
    if [ -z "$CURRENT" ]; then
        CURRENT="${SHELL:-/bin/bash}"
    fi

    printf "Changing shell for %s.\n" "${USER:-root}"
    printf "Current shell: %s\n" "$CURRENT"
    printf "New shell [%s]: " "$CURRENT"
    read -r user_input
    if [ -z "$user_input" ]; then
        NEW_SHELL="$CURRENT"
    else
        NEW_SHELL="$user_input"
    fi
fi

RESOLVED="$(resolve_shell "$NEW_SHELL" || true)"

if [ -z "$RESOLVED" ]; then
    echo "chsh: '$NEW_SHELL' is not executable or not found." >&2
    echo "Make sure the shell package is installed (e.g., 'cpm install $NEW_SHELL' or 'apk add $NEW_SHELL')." >&2
    exit 1
fi

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"
echo "$RESOLVED" > "$CONFIG_FILE"

# Also update /etc/shells if writable and not present
if [ -w /etc/shells ]; then
    if ! grep -Fxq "$RESOLVED" /etc/shells 2>/dev/null; then
        echo "$RESOLVED" >> /etc/shells 2>/dev/null || true
    fi
fi

# Also update /etc/passwd if writable
if [ -w /etc/passwd ]; then
    USER_TO_UPDATE="${USER:-root}"
    sed -i "s|^\(${USER_TO_UPDATE}:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:\).*$|\1${RESOLVED}|" /etc/passwd 2>/dev/null || true
fi

echo "Shell changed to: $RESOLVED"
echo "Restart your terminal session for changes to take effect."
